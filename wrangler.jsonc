{
  "name": "nasa-spaceapps",
  // Worker generated by @sveltejs/adapter-cloudflare (npm run build). scripts/cf-postbuild.js appends the
  // Durable Object exports to it after the build.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  // Prerendered pages and static files (terrain, Jarvis mp3s) are served straight from here.
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // Operator cue channel and VR spectator rooms.
  "durable_objects": {
    "bindings": [
      { "name": "JARVIS_CUE", "class_name": "CueChannel" },
      { "name": "VR_SHARE", "class_name": "ShareRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CueChannel"] },
    { "tag": "v2", "new_sqlite_classes": ["ShareRoom"] }
  ],
  // Secrets (set them in the Workers dashboard or with `npx wrangler secret put <NAME>`):
  //   ANTHROPIC_API_KEY, GROQ_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID, DEMO_TOKEN (required on a public URL)
  // Optional plain variable: ELEVENLABS_MODEL_ID (default eleven_flash_v2_5).
  "previews": {}
}
