# Jarvis voice assistant — server-side secrets. Copy to `.env` (git-ignored) and fill in.
# Read by SvelteKit via src/env.ts → `$app/env/private` (server only; never sent to the browser)
# and by `npm run gen:lines`. Restart `npm run dev` after editing.
# Any missing key makes only its endpoint answer HTTP 503 naming the variable.

# --- Claude (POST /api/chat, model claude-haiku-5-5) ---------------------------------
# https://console.anthropic.com → API keys. Pay-as-you-go.
# REMINDER: set a monthly spend limit (e.g. $5) in Console → Settings → Limits before the demo.
ANTHROPIC_API_KEY=

# --- Groq Whisper (POST /api/stt, model whisper-large-v3-turbo) -----------------------
# https://console.groq.com/keys — free tier is enough for this demo (check limits in the console).
GROQ_API_KEY=

# --- ElevenLabs (POST /api/tts and `npm run gen:lines`) -------------------------------
# https://elevenlabs.io/app/settings/api-keys — the free plan works (limited monthly credits; credit "Voice: ElevenLabs" in the video).
# Give the key Text to Speech + Voices (read) permission.
ELEVENLABS_API_KEY=
# Use a PREMADE/default voice id (Voices → "Default" voices, or GET https://api.elevenlabs.io/v1/voices).
# Voice Library voices may not be usable via API on the free plan.
ELEVENLABS_VOICE_ID=
# Optional. Default: eleven_flash_v2_5 (lowest latency, English OK). Alternatives: eleven_multilingual_v2 (higher quality, slower).
ELEVENLABS_MODEL_ID=

# --- Tunnel mode only (Cloudflare quick tunnel fallback, spec §8.2) -------------------
# Leave EMPTY for USB + adb reverse. When set, every /api/* call needs header `x-demo-token`
# or `?k=<token>` (opening a page with ?k=<token> also sets a cookie), and stt/chat/tts are
# limited to 10 requests per minute per IP and endpoint. Close the tunnel after recording.
DEMO_TOKEN=

# --- Recording ------------------------------------------------------------------------
# Set to 1 while recording takes: disables Vite HMR so a file save can't kick the headset out of VR.
JARVIS_RECORDING=
